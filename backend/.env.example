APP_NAME=MistakeTutor API
APP_ENV=development
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite:///./storage/mistaketutor.db

# Auth - replace AUTH_SECRET_KEY in local .env
AUTH_SECRET_KEY=change-me-in-local-env
AUTH_TOKEN_EXPIRE_MINUTES=1440

# LLM provider config - do not put real keys in git
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Read by app.core.config.Settings and used by the guarded generation
# fallback ladder (app.core.prompts.fallback.run_guarded_generation).
# Each name must have a matching *_API_KEY above set to be usable - see
# app.core.llm.client._build_providers(). Only gemini/openai/openrouter are
# implemented; PRIMARY and FALLBACK can be any two of them.
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openai
LLM_DEADLINE_S=10
ENABLE_LLM_JUDGE=false

# Retrieval config
VECTOR_STORE_PROVIDER=local
VECTOR_STORE_PATH=./storage/vector-store
TOP_K_RETRIEVAL=4

# Qdrant vector store
QDRANT_URL=http://127.0.0.1:6663
QDRANT_COLLECTION=mistaketutor_sources
EMBEDDING_DIM=768

# Runtime safety
LLM_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
