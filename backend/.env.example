APP_NAME=MistakeTutor API
APP_ENV=development
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite:///./storage/mistaketutor.db

# Auth - replace AUTH_SECRET_KEY in local .env
AUTH_SECRET_KEY=change-me-in-local-env
AUTH_TOKEN_EXPIRE_MINUTES=1440

# LLM provider config - do not put real keys in git
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Retrieval config
VECTOR_STORE_PROVIDER=local
VECTOR_STORE_PATH=./storage/vector-store
TOP_K_RETRIEVAL=4

# Qdrant vector store
QDRANT_URL=http://127.0.0.1:6663
QDRANT_SOURCES_COLLECTION=mistaketutor_sources
QDRANT_EXPLANATIONS_COLLECTION=mistaketutor_explanations
QDRANT_GAP_DIAGNOSES_COLLECTION=mistaketutor_gap_diagnoses
QDRANT_EVAL_CASES_COLLECTION=mistaketutor_eval_cases
EMBEDDING_DIM=768

# Runtime safety
LLM_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
